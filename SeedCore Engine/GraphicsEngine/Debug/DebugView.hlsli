#ifndef __DEBUG_VIEW_HLSL__
#define __DEBUG_VIEW_HLSL__

/// Values of RenderViewMode (RenderView.h), as written to SceneConstantBuffer::view_mode_.
#define VIEW_MODE_LIT 0
#define VIEW_MODE_UNLIT 1
#define VIEW_MODE_WIREFRAME 2
#define VIEW_MODE_DETAIL_LIGHTING 3
#define VIEW_MODE_LIGHTING_ONLY 4
#define VIEW_MODE_REFLECTIONS 5
#define VIEW_MODE_BUFFER_BASE_COLOR 6
#define VIEW_MODE_BUFFER_NORMAL 7
#define VIEW_MODE_BUFFER_ROUGHNESS 8
#define VIEW_MODE_BUFFER_METALLIC 9
#define VIEW_MODE_BUFFER_EMISSIVE 10
#define VIEW_MODE_BUFFER_DEPTH 11
#define VIEW_MODE_BUFFER_VELOCITY 12
#define VIEW_MODE_BUFFER_POSITION 13
#define VIEW_MODE_BUFFER_MATERIAL 14
#define VIEW_MODE_BUFFER_OVERVIEW 15
#define VIEW_MODE_MESHLET_ID 16
#define VIEW_MODE_MESHLET_TRIANGLE 17
#define VIEW_MODE_MESHLET_CLUSTER 18
#define VIEW_MODE_MESHLET_INSTANCE 19
#define VIEW_MODE_MESHLET_LEVEL 20
#define VIEW_MODE_MESHLET_ERROR 21
#define VIEW_MODE_MESHLET_CULLING 22
#define VIEW_MODE_MESHLET_BOUNDS 23
#define VIEW_MODE_MESHLET_OVERDRAW 24
#define VIEW_MODE_DIRECT_DIFFUSE 25
#define VIEW_MODE_DIRECT_SPECULAR 26
#define VIEW_MODE_INDIRECT_DIFFUSE 27
#define VIEW_MODE_INDIRECT_SPECULAR 28
#define VIEW_MODE_LIGHT_COMPLEXITY 29
#define VIEW_MODE_LIGHT_CLUSTER 30
#define VIEW_MODE_RAY_DISTANCE 31
#define VIEW_MODE_RAY_HIT 32
#define VIEW_MODE_RAY_DIRECTION 33
#define VIEW_MODE_RAY_COUNT 34
#define VIEW_MODE_RAY_INSTANCE 35
#define VIEW_MODE_RAY_GEOMETRY 36
#define VIEW_MODE_RESERVOIR_COUNT 37
#define VIEW_MODE_RESERVOIR_WEIGHT 38
#define VIEW_MODE_RESERVOIR_AGE 39
#define VIEW_MODE_RESERVOIR_RADIANCE 40
#define VIEW_MODE_RESERVOIR_TEMPORAL 41
#define VIEW_MODE_RESERVOIR_SPATIAL 42
#define VIEW_MODE_RESERVOIR_REJECTION 43
#define VIEW_MODE_DENOISER_RAW 44
#define VIEW_MODE_DENOISER_DENOISED 45
#define VIEW_MODE_DENOISER_VARIANCE 46
#define VIEW_MODE_DENOISER_LENGTH 47
#define VIEW_MODE_DENOISER_VALIDITY 48
#define VIEW_MODE_DENOISER_REPROJECTION 49
#define VIEW_MODE_SHADER_COMPLEXITY 50
#define VIEW_MODE_QUAD_OVERDRAW 51
#define VIEW_MODE_TRIANGLE_DENSITY 52
#define VIEW_MODE_MESHLET_DENSITY 53
#define VIEW_MODE_TEXTURE_MIP 54
#define VIEW_MODE_LOD_COLORATION 55
#define VIEW_MODE_POST_COLOR 56
#define VIEW_MODE_POST_LUMINANCE 57
#define VIEW_MODE_POST_BLOOM 58
#define VIEW_MODE_POST_EXPOSURE 59
#define VIEW_MODE_POST_TONEMAP 60
#define VIEW_MODE_UPSCALE_INPUT 61
#define VIEW_MODE_UPSCALE_OUTPUT 62

/// Values of RenderDebugSource, as written to SceneConstantBuffer::debug_source_.
#define DEBUG_SOURCE_REFLECTION 0
#define DEBUG_SOURCE_GLOBAL_ILLUMINATION 1
#define DEBUG_SOURCE_SHADOW 2
#define DEBUG_SOURCE_AMBIENT_OCCLUSION 3

/// Low-word bits of RenderShowFlag, as written to SceneConstantBuffer::show_flags_low_.
#define SHOW_FLAG_MODEL (1u << 0)
#define SHOW_FLAG_PRIMITIVE (1u << 1)
#define SHOW_FLAG_TRANSPARENT (1u << 2)
#define SHOW_FLAG_FUR (1u << 3)
#define SHOW_FLAG_DIRECT_LIGHT (1u << 9)

/// Bits the visibility pass writes into Geometry.Debug: the pixel's meshlet was drawn by the late (occlusion re-test) pass.
#define DEBUG_GEOMETRY_LATE 1u

/// Bits a ReSTIR pass writes into its per-pixel reuse word: the temporal history was combined, the temporal history was rejected, and (from bit 8) how many spatial neighbours were combined.
#define DEBUG_REUSE_TEMPORAL 1u
#define DEBUG_REUSE_REJECTED 2u
#define DEBUG_REUSE_SPATIAL_SHIFT 8u

#endif // __DEBUG_VIEW_HLSL__
