<Project>
	<PropertyGroup Condition="'$(MSBuildProjectExtension)' == '.csproj'">
		<Configuration Condition="'$(Configuration)' == ''">Debug</Configuration>
		<TargetFramework>net10.0</TargetFramework>
		<LangVersion>14</LangVersion>
		<Nullable>disable</Nullable>
		<ImplicitUsings>disable</ImplicitUsings>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<RootNamespace>SeedCore</RootNamespace>
		<PlatformTarget>x64</PlatformTarget>
		<EnableDefaultNoneItems>false</EnableDefaultNoneItems>
		<EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
		<BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)Runtime\Intermediate\$(MSBuildProjectName)\</BaseIntermediateOutputPath>
		<OutputPath>$(MSBuildThisFileDirectory)Runtime\Build\x64\$(Configuration)\Csharp\</OutputPath>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
		<AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
	</PropertyGroup>
</Project>
